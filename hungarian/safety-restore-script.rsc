# 2026-07-05 by RouterOS 7.23.1
/system script
add dont-require-permissions=no name=safety-restore owner=Sprotni policy=\
    ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon source="#\
    \_========================================================================\
    =====\n# =============================================================================\n#  BEALLITASOK\n# =============================================================================\n\n:global safetyRestoreFile \"ez_a_backup_fajlnev.backup\"\n:global safetyRestorePassword \"\"\n\n\n# =============================================================================\n#  safety-restore\n#  Visszaallitas. A router automatikusan ujraindul a backup load utan.\n# =============================================================================\n#\n#  Futtatas:\n#      /system script run safety-restore\n#\n#  Utemezes:\n#      System -> Scheduler -> safety-restore-schedule\n#      on-event   = safety-restore\n#      start-time = 22:30:00\n#      disabled   = no\n#\n#  Lemondas:\n#      /system scheduler disable safety-restore-schedule\n#\n# =============================================================================\n\n\n# -- 1. fajlnev megadva\? -----------------------------------------------------\n\n:local fileType [:typeof \$safetyRestoreFile]\n\n:if (\$fileType = \"nothing\") do={\n    :log error \"safety-restore: nincs beallitva a safetyRestoreFile\"\n    :error \"Allitsd be a fajlnevet a szkript elejen\"\n}\n\n:local fileLen [:len \$safetyRestoreFile]\n\n:if (\$fileLen = 0) do={\n    :log error \"safety-restore: ures a safetyRestoreFile\"\n    :error \"Allitsd be a fajlnevet a szkript elejen\"\n}\n\n\n# -- 2. jelszo (ures = titkositas nelkuli mentes) ------------------------------\n\n:local pwd \"\"\n:local pwdType [:typeof \$safetyRestorePassword]\n\n:if (\$pwdType != \"nothing\") do={\n    :set pwd \$safetyRestorePassword\n}\n\n\n# -- 3. .backup vegzodes -----------------------------------------------------\n\n:local fname \$safetyRestoreFile\n:local dotPos [:find \$fname \".backup\"]\n\n:if (\$dotPos < 0) do={\n    :set fname (\$fname . \".backup\")\n}\n\n\n# -- 4. fajl letezik a routeren\? ---------------------------------------------\n\n:local fileId [/file find name=\$fname]\n\n:if (\$fileId = \"\") do={\n    :log error (\"safety-restore: nincs ilyen fajl: \" . \$fname)\n    :error (\"Backup fajl nem talalhato: \" . \$fname)\n}\n\n\n# -- 5. betoltesi nev (kiterjesztes nelkul) -----------------------------------\n\n:local loadName \$fname\n:local backupDot [:find \$loadName \".backup\"]\n\n:if (\$backupDot >= 0) do={\n    :local nameLen [:len \$loadName]\n    :local stripLen (\$nameLen - 7)\n    :set loadName [:pick \$loadName 0 \$stripLen]\n}\n\n\n# -- 6. visszaallitas --------------------------------------------------------\n\n:log warning (\"safety-restore: fajl: \" . \$fname)\n\n:if ([:len \$pwd] = 0) do={\n    :log warning \"safety-restore: jelszo nelkuli mentes, ujraindulas kovetkezik!\"\n    /system backup load name=\$loadName password=\"\"\n} else={\n    :log warning \"safety-restore: titkositott mentes, ujraindulas kovetkezik!\"\n    /system backup load name=\$loadName password=\$pwd\n}\
    \n"