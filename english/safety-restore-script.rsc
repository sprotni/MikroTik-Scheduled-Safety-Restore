# 2026-07-05 by RouterOS 7.23.1
/system script
add dont-require-permissions=no name=safety-restore owner=Sprotni policy=\
    ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon source="#\
    \_========================================================================\
    =====\n# =============================================================================\n#  SETTINGS\n# =============================================================================\n\n:global safetyRestoreFile \"your_backup_filename.backup\"\n:global safetyRestorePassword \"\"\n\n\n# =============================================================================\n#  safety-restore\n#  Restore. The router reboots automatically after the backup is loaded.\n# =============================================================================\n#\n#  Run:\n#      /system script run safety-restore\n#\n#  Schedule:\n#      System -> Scheduler -> safety-restore-schedule\n#      on-event   = safety-restore\n#      start-time = 22:30:00\n#      disabled   = no\n#\n#  Cancel:\n#      /system scheduler disable safety-restore-schedule\n#\n# =============================================================================\n\n\n# -- 1. filename configured\? -------------------------------------------------\n\n:local fileType [:typeof \$safetyRestoreFile]\n\n:if (\$fileType = \"nothing\") do={\n    :log error \"safety-restore: safetyRestoreFile is not set\"\n    :error \"Set the filename at the top of the script\"\n}\n\n:local fileLen [:len \$safetyRestoreFile]\n\n:if (\$fileLen = 0) do={\n    :log error \"safety-restore: safetyRestoreFile is empty\"\n    :error \"Set the filename at the top of the script\"\n}\n\n\n# -- 2. password (empty = unencrypted backup) ----------------------------------\n\n:local pwd \"\"\n:local pwdType [:typeof \$safetyRestorePassword]\n\n:if (\$pwdType != \"nothing\") do={\n    :set pwd \$safetyRestorePassword\n}\n\n\n# -- 3. .backup suffix -------------------------------------------------------\n\n:local fname \$safetyRestoreFile\n:local dotPos [:find \$fname \".backup\"]\n\n:if (\$dotPos < 0) do={\n    :set fname (\$fname . \".backup\")\n}\n\n\n# -- 4. file exists on the router\? -------------------------------------------\n\n:local fileId [/file find name=\$fname]\n\n:if (\$fileId = \"\") do={\n    :log error (\"safety-restore: file not found: \" . \$fname)\n    :error (\"Backup file not found: \" . \$fname)\n}\n\n\n# -- 5. load name (without extension) ------------------------------------------\n\n:local loadName \$fname\n:local backupDot [:find \$loadName \".backup\"]\n\n:if (\$backupDot >= 0) do={\n    :local nameLen [:len \$loadName]\n    :local stripLen (\$nameLen - 7)\n    :set loadName [:pick \$loadName 0 \$stripLen]\n}\n\n\n# -- 6. restore --------------------------------------------------------------\n\n:log warning (\"safety-restore: file: \" . \$fname)\n\n:if ([:len \$pwd] = 0) do={\n    :log warning \"safety-restore: unencrypted backup, reboot follows!\"\n    /system backup load name=\$loadName password=\"\"\n} else={\n    :log warning \"safety-restore: encrypted backup, reboot follows!\"\n    /system backup load name=\$loadName password=\$pwd\n}\
    \n"